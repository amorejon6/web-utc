<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>GRADOS</schema:name>
      <schema:description>Nombre del grado académico</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Curso de ingreso</schema:name>
      <schema:description>Año de ingreso de los estudiantes al programa</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Alumnos iniciales</schema:name>
      <schema:description>Número total de alumnos que iniciaron el programa</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Titulados en tiempo previsto en plan de estudios (d)  o en (d+1)</schema:name>
      <schema:description>Número total de titulados en el tiempo previsto o en el año siguiente según el plan de estudios</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Tasa de graduación (%)</schema:name>
      <schema:description>Tasa de graduación total expresada en porcentaje</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Alumnos iniciales</schema:name>
      <schema:description>Número de mujeres que iniciaron el programa</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Titulados en tiempo previsto en plan de estudios (d)  o en (d+1)</schema:name>
      <schema:description>Número de mujeres tituladas en el tiempo previsto o en el año siguiente según el plan de estudios</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Tasa de graduación (%)</schema:name>
      <schema:description>Tasa de graduación de mujeres expresada en porcentaje</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Alumnos iniciales</schema:name>
      <schema:description>Número de hombres que iniciaron el programa</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Titulados en tiempo previsto en plan de estudios (d)  o en (d+1)</schema:name>
      <schema:description>Número de hombres titulados en el tiempo previsto o en el año siguiente según el plan de estudios</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Tasa de graduación (%)</schema:name>
      <schema:description>Tasa de graduación de hombres expresada en porcentaje</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>