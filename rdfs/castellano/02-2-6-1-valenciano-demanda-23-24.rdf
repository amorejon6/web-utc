<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>CENTRO</schema:name>
      <schema:description>Nombre de la institución educativa</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - VALENCIANO</schema:name>
      <schema:description>Total de estudiants valencians</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - CASTELLANO</schema:name>
      <schema:description>Total de estudiants castellans</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - INDIFERENTE</schema:name>
      <schema:description>Total de estudiants indiferents</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - NS/NC</schema:name>
      <schema:description>Total de estudiants sense resposta</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - VALENCIANO</schema:name>
      <schema:description>Nombre de dones valencianes</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - CASTELLANO</schema:name>
      <schema:description>Nombre de dones castellanes</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - INDIFERENTE</schema:name>
      <schema:description>Nombre de dones indiferents</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - NS/NC</schema:name>
      <schema:description>Nombre de dones sense resposta</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - VALENCIANO</schema:name>
      <schema:description>Nombre d'homes valencians</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - CASTELLANO</schema:name>
      <schema:description>Nombre d'homes castellans</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - INDIFERENTE</schema:name>
      <schema:description>Nombre d'homes indiferents</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - NS/NC</schema:name>
      <schema:description>Nombre d'homes sense resposta</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>