<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>Administración (convocatoria estudios de grado)</schema:name>
      <schema:description>Entidad administrativa responsable de convocatorias de estudios de grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Cuantía para estudiantes de grado</schema:name>
      <schema:description>Cantidad asignada a estudiantes de grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>