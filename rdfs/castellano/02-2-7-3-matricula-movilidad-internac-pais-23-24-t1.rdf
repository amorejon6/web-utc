<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>Estudiantado enviado</schema:name>
      <schema:description>País de envío de estudiantes</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Total</schema:name>
      <schema:description>Total de estudiantes enviados</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Mujeres</schema:name>
      <schema:description>Número de mujeres estudiantes enviadas</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Hombres</schema:name>
      <schema:description>Número de hombres estudiantes enviados</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>