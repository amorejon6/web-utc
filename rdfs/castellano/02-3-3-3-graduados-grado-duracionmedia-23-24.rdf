<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>GRADOS</schema:name>
      <schema:description>Nombre del grado o programa académico</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Media  Total</schema:name>
      <schema:description>Media general de calificaciones del grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Media Mujeres</schema:name>
      <schema:description>Media de calificaciones de las mujeres en el grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Media Hombres</schema:name>
      <schema:description>Media de calificaciones de los hombres en el grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>