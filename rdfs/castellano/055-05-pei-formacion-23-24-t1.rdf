<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>Personal de investigación (I-PI): ÁREA DE FORMACIÓN (HORAS)</schema:name>
      <schema:description>Nombre del área de formación</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Horas de formación realizadas/impartidas - TOTAL</schema:name>
      <schema:description>Total de horas de formación realizadas o impartidas</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Horas de formación realizadas/impartidas - MUJERES</schema:name>
      <schema:description>Horas de formación realizadas o impartidas por mujeres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Horas de formación realizadas/impartidas - HOMBRES</schema:name>
      <schema:description>Horas de formación realizadas o impartidas por hombres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>