<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>GRADOS</schema:name>
      <schema:description>Nombre del grado o programa académico</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Créditos Matriculados</schema:name>
      <schema:description>Total de créditos matriculados en el grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Créditos Matriculados Aptos</schema:name>
      <schema:description>Total de créditos matriculados aptos en el grado</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Tasa de rendimiento (%)</schema:name>
      <schema:description>Tasa de rendimiento total en porcentaje</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Créditos Matriculados</schema:name>
      <schema:description>Total de créditos matriculados de mujeres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Créditos Matriculados Aptos</schema:name>
      <schema:description>Total de créditos matriculados aptos de mujeres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Tasa de rendimiento (%)</schema:name>
      <schema:description>Tasa de rendimiento de mujeres en porcentaje</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Créditos Matriculados</schema:name>
      <schema:description>Total de créditos matriculados de hombres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Créditos Matriculados Aptos</schema:name>
      <schema:description>Total de créditos matriculados aptos de hombres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Tasa de rendimiento (%)</schema:name>
      <schema:description>Tasa de rendimiento de hombres en porcentaje</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>