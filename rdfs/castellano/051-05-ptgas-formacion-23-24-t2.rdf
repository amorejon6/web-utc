<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>ÁREA DE FORMACIÓN (NÚMERO PTGAS)</schema:name>
      <schema:description>Área de formación (número PTGAS) que ha realizado cursos de formación</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Núm. PTGAS que ha realizado/impartido cursos de formación - TOTAL</schema:name>
      <schema:description>Número total de PTGAS que ha realizado/impartido cursos de formación</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Núm. PTGAS que ha realizado/impartido cursos de formación - MUJERES</schema:name>
      <schema:description>Número de PTGAS que ha realizado/impartido cursos de formación para mujeres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Núm. PTGAS que ha realizado/impartido cursos de formación - HOMBRES</schema:name>
      <schema:description>Número de PTGAS que ha realizado/impartido cursos de formación para hombres</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>