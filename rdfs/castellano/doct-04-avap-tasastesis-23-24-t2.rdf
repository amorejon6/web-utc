<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>PROGRAMAS DE DOCTORADO - DOCTORES/AS CON MENCIÓN INTERNACIONAL</schema:name>
      <schema:description>Nombre del programa de doctorado</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Text"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Doctores/as con mención internacional</schema:name>
      <schema:description>Número total de doctores/as con mención internacional en el programa</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Tesis defendidas</schema:name>
      <schema:description>Número total de tesis defendidas en el programa</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Doctores/as con mención internacional (%)</schema:name>
      <schema:description>Porcentaje de doctores/as con mención internacional respecto al total de tesis defendidas</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Float"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Doctores/as con mención internacional</schema:name>
      <schema:description>Número de mujeres doctores/as con mención internacional en el programa</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Tesis defendidas</schema:name>
      <schema:description>Número de tesis defendidas por mujeres en el programa</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>MUJERES - Doctores/as con mención internacional (%)</schema:name>
      <schema:description>Porcentaje de mujeres doctores/as con mención internacional respecto al total de tesis defendidas por mujeres</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Float"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Doctores/as con mención internacional</schema:name>
      <schema:description>Número de hombres doctores/as con mención internacional en el programa</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Tesis defendidas</schema:name>
      <schema:description>Número de tesis defendidas por hombres en el programa</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMBRES - Doctores/as con mención internacional (%)</schema:name>
      <schema:description>Porcentaje de hombres doctores/as con mención internacional respecto al total de tesis defendidas por hombres</schema:description>
      <schema:valueType rdf:resource="http://schema.org/Float"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>