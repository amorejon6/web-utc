<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>Administració (convocatòria estudis de màster)</schema:name>
      <schema:description>Administració responsable de la convocatòria d'estudis de màster</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Quantia per a estudiants de màster</schema:name>
      <schema:description>Quantia assignada a estudiants de màster per a la convocatòria</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>