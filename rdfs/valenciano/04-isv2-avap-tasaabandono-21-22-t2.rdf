<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>MÀSTERS</schema:name>
      <schema:description>Nom del màster</schema:description>
      <schema:valueType rdf:resource="schema:String"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Alumnes nous  (n-2)</schema:name>
      <schema:description>Total d'alumnes nous inscrits en el màster el curs anterior</schema:description>
      <schema:valueType rdf:resource="schema:Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Nous que abandonen  (n i n-1)</schema:name>
      <schema:description>Total de nous que abandonen el màster en els dos cursos anteriors</schema:description>
      <schema:valueType rdf:resource="schema:Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Taxa Abandó (%)</schema:name>
      <schema:description>Taxa d'abandó de nous alumnes en percentatge</schema:description>
      <schema:valueType rdf:resource="schema:Float"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - Alumnes nous  (n-2)</schema:name>
      <schema:description>Total d'alumnes dones nous inscrits en el màster el curs anterior</schema:description>
      <schema:valueType rdf:resource="schema:Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - Nous que abandonen  (n i n-1)</schema:name>
      <schema:description>Total de dones que abandonen el màster en els dos cursos anteriors</schema:description>
      <schema:valueType rdf:resource="schema:Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - Taxa Abandó (%)</schema:name>
      <schema:description>Taxa d'abandó de dones en percentatge</schema:description>
      <schema:valueType rdf:resource="schema:Float"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - Alumnes nous  (n-2)</schema:name>
      <schema:description>Total d'alumnes homes nous inscrits en el màster el curs anterior</schema:description>
      <schema:valueType rdf:resource="schema:Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - Nous que abandonen  (n i n-1)</schema:name>
      <schema:description>Total d'homes que abandonen el màster en els dos cursos anteriors</schema:description>
      <schema:valueType rdf:resource="schema:Integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - Taxa Abandó (%)</schema:name>
      <schema:description>Taxa d'abandó d'homes en percentatge</schema:description>
      <schema:valueType rdf:resource="schema:Float"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>