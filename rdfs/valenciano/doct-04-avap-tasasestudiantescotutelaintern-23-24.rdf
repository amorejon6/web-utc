<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>PROGRAMES DE DOCTORAT</schema:name>
      <schema:description>Nom del programa de doctorat</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Estudiants en règim de cotutela internacional</schema:name>
      <schema:description>Total d'estudiants en règim de cotutela internacional</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Estudiants matriculats</schema:name>
      <schema:description>Total d'estudiants matriculats</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - Estudiants en règim de cotutela internacional (%)</schema:name>
      <schema:description>Percentatge d'estudiants en règim de cotutela internacional</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - Estudiants en règim de cotutela internacional</schema:name>
      <schema:description>Total d'estudiants dones en règim de cotutela internacional</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - Estudiants matriculats</schema:name>
      <schema:description>Total d'estudiants dones matriculats</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - Estudiants en règim de cotutela internacional (%)</schema:name>
      <schema:description>Percentatge d'estudiants dones en règim de cotutela internacional</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - Estudiants en règim de cotutela internacional</schema:name>
      <schema:description>Total d'estudiants homes en règim de cotutela internacional</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - Estudiants matriculats</schema:name>
      <schema:description>Total d'estudiants homes matriculats</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - Estudiants en règim de cotutela internacional (%)</schema:name>
      <schema:description>Percentatge d'estudiants homes en règim de cotutela internacional</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>