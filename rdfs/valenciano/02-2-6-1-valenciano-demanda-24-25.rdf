<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>CENTRE</schema:name>
      <schema:description>Nom de l'entitat educativa</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - VALENCIÀ</schema:name>
      <schema:description>Percentatge total de respostes en valencià</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - CASTELLÀ</schema:name>
      <schema:description>Percentatge total de respostes en castellà</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - INDIFERENT</schema:name>
      <schema:description>Percentatge total de respostes indiferents</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>TOTAL - NS/NC</schema:name>
      <schema:description>Percentatge total de respostes sense especificar/ no conegut</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - VALENCIÀ</schema:name>
      <schema:description>Percentatge de dones que responen en valencià</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - CASTELLÀ</schema:name>
      <schema:description>Percentatge de dones que responen en castellà</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - INDIFERENT</schema:name>
      <schema:description>Percentatge de dones que responen indiferent</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>DONES - NS/NC</schema:name>
      <schema:description>Percentatge de dones que responen sense especificar/ no conegut</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - VALENCIÀ</schema:name>
      <schema:description>Percentatge d'homes que responen en valencià</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - CASTELLÀ</schema:name>
      <schema:description>Percentatge d'homes que responen en castellà</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - INDIFERENT</schema:name>
      <schema:description>Percentatge d'homes que responen indiferent</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>HOMES - NS/NC</schema:name>
      <schema:description>Percentatge d'homes que responen sense especificar/ no conegut</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>