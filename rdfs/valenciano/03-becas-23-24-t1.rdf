<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>Administració (convocatòria estudis de grau)</schema:name>
      <schema:description>Administració responsable de les convocatòries d'estudis de grau</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Quantia per a estudiants de grau</schema:name>
      <schema:description>Quantia assignada als estudiants de grau</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>