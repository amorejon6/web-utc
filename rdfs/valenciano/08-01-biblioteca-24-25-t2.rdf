<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>FONS BIBLIOGRÀFICS</schema:name>
      <schema:description>Tipus de fons bibliogràfic</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
