<dcat:Distribution>
  <schema:variableMeasured>
    <schema:PropertyValue>
      <schema:name>ÀREA DE FORMACIÓ (NOMBRE PTGAS)</schema:name>
      <schema:description>Àrea de formació (nom del PTGA)</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Nre. PTGAS que ha fet/impartit cursos de formació - TOTAL</schema:name>
      <schema:description>Total de PTGAS que han fet cursos de formació</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Nre. PTGAS que ha fet/impartit cursos de formació - DONES</schema:name>
      <schema:description>Nombre de PTGAS que han fet cursos de formació de dones</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
    <schema:PropertyValue>
      <schema:name>Nre. PTGAS que ha fet/impartit cursos de formació - HOMES</schema:name>
      <schema:description>Nombre de PTGAS que han fet cursos de formació d'homes</schema:description>
      <schema:valueType rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </schema:PropertyValue>
  </schema:variableMeasured>
</dcat:Distribution>